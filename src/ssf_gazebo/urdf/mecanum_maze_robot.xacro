<?xml version="1.0"?>
<!--
  Mecanum Omnidirectional Robot for Maze Navigation
  Based on gz_ros2_control_demos mecanum robot, adapted for Nav2 integration.

  Additions over base:
    1. 2D LiDAR sensor for obstacle detection + costmap
    2. Odometry publisher plugin (workaround for Gazebo Harmonic odom issue)
    3. IMU sensor for better localization
    4. Sized for maze corridors (~0.4m wide robot in ~1.0m corridors)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mecanum_maze_robot">

  <!-- ==================== Properties ==================== -->
  <xacro:property name="chassis_length" value="0.35"/>
  <xacro:property name="chassis_width" value="0.30"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass" value="5.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_separation_x" value="0.14"/>
  <xacro:property name="wheel_separation_y" value="0.17"/>

  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_radius" value="0.03"/>

  <!-- ==================== Macros ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
        iyy="${m*(x*x+z*z)/12}" iyz="0"
        izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
        iyy="${m*(3*r*r+h*h)/12}" iyz="0"
        izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="mecanum_wheel" params="name x y z roll">
    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.5</mu2>
              <slip1>0.001</slip1>
              <slip2>0.001</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.01" friction="0.01"/>
    </joint>
  </xacro:macro>

  <!-- ==================== Base Link ==================== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Wheels ==================== -->
  <!-- Front Left -->
  <xacro:mecanum_wheel name="front_left_wheel"
    x="${wheel_separation_x}" y="${wheel_separation_y + wheel_width/2}"
    z="0" roll="${-pi/2}"/>

  <!-- Front Right -->
  <xacro:mecanum_wheel name="front_right_wheel"
    x="${wheel_separation_x}" y="${-(wheel_separation_y + wheel_width/2)}"
    z="0" roll="${pi/2}"/>

  <!-- Rear Left -->
  <xacro:mecanum_wheel name="rear_left_wheel"
    x="${-wheel_separation_x}" y="${wheel_separation_y + wheel_width/2}"
    z="0" roll="${-pi/2}"/>

  <!-- Rear Right -->
  <xacro:mecanum_wheel name="rear_right_wheel"
    x="${-wheel_separation_x}" y="${-(wheel_separation_y + wheel_width/2)}"
    z="0" roll="${pi/2}"/>

  <!-- ==================== LiDAR Sensor ==================== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.0 0.0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_height/2 + lidar_height/2 + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo LiDAR sensor plugin -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ==================== IMU Sensor ==================== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==================== Gazebo Plugins ==================== -->

  <!-- Velocity Control: applies cmd_vel directly to model (supports holonomic vx, vy, omega).
       MecanumDrive plugin does NOT exist in Fortress (added in Garden/gz-sim7).
       VelocityControl bypasses wheel physics but provides correct holonomic motion.
       Default topic: /model/{model_name}/cmd_vel -->
  <gazebo>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl">
    </plugin>
  </gazebo>

  <!-- Odometry Publisher: computes odometry from model pose.
       Uses absolute /odom topic to avoid bridge remapping issues.
       TF handled by odom_tf_broadcaster node (Pose_V bridge unreliable on Fortress) -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
      <odom_topic>/odom</odom_topic>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- (Chase camera attempt removed — URDF-attached camera disrupted Nav2 TF tree.
       Follow view is now provided by a static low-angle camera in warehouse_cam.sdf.) -->

</robot>
